---
import { site } from '../site.config';

interface Props {
  /** Over a hero the header floats transparently; elsewhere it needs a ground. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

// Compare without trailing slashes so /work/ and /work/sport/ both mark Work
// as current, whichever way the link was written.
const strip = (s: string) => s.replace(/\/+$/, '') || '/';
const path = strip(Astro.url.pathname);
const isCurrent = (href: string) => {
  const target = strip(href);
  return target !== '/' && (path === target || path.startsWith(`${target}/`));
};
---

<header class:list={['site-header', { overlay }]}>
  <div class="wrap">
    <a class="wordmark" href="/">
      {site.name}
      <span>{site.discipline}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* Three short items fit comfortably at 375px, so there is no hamburger:
     it would hide working navigation behind a tap to solve nothing. Revisit
     if the nav ever reaches five or six items. */
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    padding-block: clamp(1.1rem, 2.4vw, 2rem);
    background: var(--bg);
  }
  .site-header.overlay { background: transparent; }

  .site-header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .wordmark {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .wordmark span {
    display: block;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--muted);
    font-size: 0.62rem;
  }

  .nav {
    display: flex;
    gap: clamp(1.1rem, 2.6vw, 2.4rem);
  }
  .nav a {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    border-bottom-color: var(--fg);
  }

  @media (max-width: 22rem) {
    .nav { gap: 0.9rem; }
    .nav a { letter-spacing: 0.1em; }
  }
</style>
