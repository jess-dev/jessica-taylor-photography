---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="label">Enquiries</p>
      {
        site.email ? (
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        ) : (
          <p><a href="/contact/">Get in touch →</a></p>
        )
      }
    </div>
    <div class="footer-links">
      {site.socials.map((s) => <a href={s.href} rel="me noopener">{s.label}</a>)}
    </div>
  </div>
  <div class="wrap">
    <p class="colophon">© {year} {site.name} {site.discipline}</p>
  </div>
</footer>

<style>
  /* Tighter than the content sections on purpose. Generous whitespace earns its
     place between photographs; around two lines of small print it just reads as
     a gap where something failed to load. */
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(2rem, 3.5vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
  }
  .footer-grid p { margin: 0; }
  .footer-grid .label { margin-bottom: 0.75rem; }
  .site-footer a { border-bottom: 1px solid var(--line); }
  .site-footer a:hover { border-bottom-color: var(--fg); }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    /* Without this the links stretch to the height of the taller Enquiries
       column and their underlines detach, drawing 40px below the text. */
    align-items: flex-start;
    gap: 1.5rem;
    font-size: 0.78rem;
  }
  .colophon {
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 1.75rem;
  }
</style>
