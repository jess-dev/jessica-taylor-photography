---
// No props: it binds to any [data-gallery] on the page. The only client-side
// JavaScript on the site: about 90 lines, no dependency, no framework runtime.
---

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button class="lb-btn lb-close" type="button" aria-label="Close viewer">✕</button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">‹</button>
  <button class="lb-btn lb-next" type="button" aria-label="Next photo">›</button>
  <img id="lb-img" src="" alt="" />
  <p class="lb-meta" id="lb-meta" aria-live="polite"></p>
</div>

<script>
  const box = document.getElementById('lightbox') as HTMLElement | null;
  const shots = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-gallery] .shot'),
  );

  if (box && shots.length) {
    const img = document.getElementById('lb-img') as HTMLImageElement;
    const meta = document.getElementById('lb-meta') as HTMLElement;
    const closeBtn = box.querySelector('.lb-close') as HTMLButtonElement;
    const prevBtn = box.querySelector('.lb-prev') as HTMLButtonElement;
    const nextBtn = box.querySelector('.lb-next') as HTMLButtonElement;
    const focusable = [closeBtn, prevBtn, nextBtn];

    let current = 0;
    let lastFocused: HTMLElement | null = null;

    const show = (n: number) => {
      current = (n + shots.length) % shots.length;
      const shot = shots[current];
      img.src = shot.dataset.full ?? '';
      img.alt = shot.querySelector('img')?.alt ?? '';
      meta.textContent = `${shot.dataset.caption ?? ''} · ${current + 1} / ${shots.length}`;
    };

    const open = (n: number) => {
      lastFocused = document.activeElement as HTMLElement;
      show(n);
      box.hidden = false;
      document.body.classList.add('lb-open');
      closeBtn.focus();
    };

    const close = () => {
      box.hidden = true;
      document.body.classList.remove('lb-open');
      img.src = '';
      lastFocused?.focus();
    };

    shots.forEach((shot, n) => shot.addEventListener('click', () => open(n)));
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));

    // Clicking the backdrop dismisses; clicking the photo does not.
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });

    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;

      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'Tab') {
        // Focus trap: cycle through the three controls, never escaping the dialog.
        e.preventDefault();
        const at = focusable.indexOf(document.activeElement as HTMLButtonElement);
        const next = e.shiftKey ? at - 1 : at + 1;
        focusable[(next + focusable.length) % focusable.length].focus();
      }
    });

    let startX: number | null = null;
    box.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 45) show(dx < 0 ? current + 1 : current - 1);
      startX = null;
    }, { passive: true });
  }
</script>

<style is:global>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    background: rgba(6, 6, 7, 0.97);
    padding: clamp(1rem, 4vw, 3rem);
  }
  .lightbox[hidden] { display: none; }

  .lightbox img {
    max-width: 100%;
    max-height: 82svh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lb-meta {
    position: absolute;
    inset: auto 0 clamp(1rem, 3vw, 2rem) 0;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .lb-btn {
    position: absolute;
    background: none;
    border: 0;
    color: var(--fg);
    cursor: pointer;
    padding: 1rem;
    font-size: 1.5rem;
    line-height: 1;
    opacity: 0.65;
    transition: opacity var(--t);
  }
  .lb-btn:hover { opacity: 1; }
  .lb-close { top: clamp(0.5rem, 2vw, 1.5rem); right: clamp(0.5rem, 2vw, 1.5rem); }
  .lb-prev { left: clamp(0.25rem, 2vw, 1.5rem); top: 50%; transform: translateY(-50%); }
  .lb-next { right: clamp(0.25rem, 2vw, 1.5rem); top: 50%; transform: translateY(-50%); }

  body.lb-open { overflow: hidden; }
</style>
