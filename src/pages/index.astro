---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { site } from '../site.config';
import { galleryPhotos, findPhoto, type Photo } from '../lib/gallery';

const heroDesktop = findPhoto(site.hero.desktop);
const heroMobile = findPhoto(site.hero.mobile);

if (!heroDesktop) {
  throw new Error(`Hero image not found: ${site.hero.desktop}`);
}

const galleries = (await getCollection('galleries')).sort((a, b) => a.data.order - b.data.order);
const live = galleries.filter((g) => !g.data.draft);

// Featured selects, drawn from whatever each gallery flags with feature: true.
const featured: Photo[] = [];
const featuredMeta: Record<string, { caption?: string; focal?: string }> = {};

for (const gallery of live) {
  const photos = galleryPhotos(gallery.id);
  for (const photo of photos) {
    const info = gallery.data.photos[photo.name];
    if (info?.feature) {
      featured.push(photo);
      featuredMeta[photo.name] = { caption: info.caption, focal: info.focal };
    }
  }
}

// Cover images for the gallery cards.
const cards = galleries.map((gallery) => ({
  gallery,
  cover: findPhoto(`${gallery.id}/${gallery.data.cover}`),
}));
---

<Base profile overlayHeader>
  <Hero
    desktop={heroDesktop}
    mobile={heroMobile}
    focal={site.hero.focal}
    eyebrow={site.tagline}
    headline={site.hero.headline}
    alt={site.hero.alt}
  />

  {/* Short and load-bearing: the main SEO signal now the headline is four words. */}
  <section class="intro">
    <div class="wrap intro-grid">
      <p class="label">{site.location.city}</p>
      <p>{site.description}</p>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <h2>Selected work</h2>
            <a class="link-out" href="/work/">All galleries</a>
          </div>
          <PhotoGrid photos={featured} meta={featuredMeta} target={3.4} numbered />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Galleries</h2>
      </div>
      <div class="genres">
        {
          cards.map(({ gallery, cover }) => {
            const soon = gallery.data.draft || !cover;
            const Tag = soon ? 'span' : 'a';
            return (
              <Tag class:list={['genre', { soon }]} href={soon ? undefined : `/work/${gallery.id}/`}>
                {
                  cover && (
                    <Image
                      src={cover.image}
                      alt=""
                      widths={[480, 768, 1024]}
                      sizes="(max-width: 52rem) 100vw, 33vw"
                      loading="lazy"
                      decoding="async"
                    />
                  )
                }
                <span class="genre-label">
                  <strong>{gallery.data.title}</strong>
                  <span>{soon ? 'Coming soon' : gallery.data.blurb.split('.')[0]}</span>
                </span>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(0, 3fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: start;
  }
  .intro-grid p:last-child {
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 300;
    line-height: 1.5;
    max-width: 60ch;
    margin: 0;
    text-wrap: pretty;
  }
  .intro-grid :global(.label) { margin: 0.35rem 0 0; }
  @media (max-width: 40rem) {
    .intro-grid { grid-template-columns: 1fr; gap: 1rem; }
  }

  .genres {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--gap);
  }
  .genre {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--bg-raised);
  }
  .genre img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.62;
    transition: opacity var(--t), transform var(--t);
  }
  .genre:hover img { opacity: 0.82; transform: scale(1.03); }

  .genre-label {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
    background: linear-gradient(to top, rgba(11, 11, 12, 0.85), rgba(11, 11, 12, 0));
  }
  .genre-label strong {
    display: block;
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .genre-label span { font-size: 0.78rem; color: var(--muted); }

  .genre.soon { pointer-events: none; }
  .genre.soon img { opacity: 0.28; filter: grayscale(1); }
</style>
